{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gadel-project-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.gadelhub.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["GITHUB_APP_ID", "GITHUB_INSTALLATION_ID", "GITHUB_PRIVATE_KEY"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_OWNER": "Gadel-Hub",
    "GITHUB_REPO": "gadelhub-dot-com",
    "GITHUB_BRANCH": "main"
  }
}
